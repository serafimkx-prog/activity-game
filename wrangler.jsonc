{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "activity-game",
  "compatibility_date": "2026-04-21",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "activity-game",
      "database_id": "87321b7e-452c-4a7a-b45f-0f70ab84c85f"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "APP_NAME": "activity-game",
    "TELEGRAM_BOT_USERNAME": ""
  }
}
